---
/* Story pager: chapter-by-chapter Back / Next buttons derived from the
   TABS order. Reads the current path from Astro.url so pages can drop
   <ChapterNav /> with no props. Overview (index 0) is the story's front
   door; chapters are numbered 01.. from Healthcare on. */
import { TABS } from '../lib/tabs';
const base = import.meta.env.BASE_URL; // ends with '/'
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const here = norm(Astro.url.pathname);
const i = TABS.findIndex((t) => norm(base + t.path) === here);
const prev = i > 0 ? TABS[i - 1] : null;
const next = i >= 0 && i < TABS.length - 1 ? TABS[i + 1] : null;
const marker = (idx: number) =>
  idx === 0 ? 'Overview' : 'Chapter ' + String(idx).padStart(2, '0');
---
{i >= 0 && (prev || next) && (
  <nav class="chapter-nav" aria-label="Chapter navigation">
    <span class="chapter-nav-eyebrow">Walk the story</span>
    <div class="chapter-nav-row">
      {prev ? (
        <a class="chapter-nav-prev" href={base + prev.path}>
          <span>&larr; Back &middot; {marker(i - 1)}</span>
          <strong>{prev.label}</strong>
        </a>
      ) : (<span></span>)}
      {next ? (
        <a class="chapter-nav-next" href={base + next.path}>
          <span>Next &middot; {marker(i + 1)} &rarr;</span>
          <strong>{next.label}</strong>
        </a>
      ) : (<span></span>)}
    </div>
  </nav>
)}
