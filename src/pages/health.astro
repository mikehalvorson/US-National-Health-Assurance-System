---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterNav from '../components/ChapterNav.astro';
import { chapterMarker, chapterNumber } from '../lib/tabs';
/* R270 [S12]: the eyebrow used to type this page's chapter number by hand,
   in a format ChapterNav did not use, next to a nav computing the same number
   from the registry. The number now comes from TABS and the format from
   chapterMarker, so reordering the registry moves both. chapterNumber throws
   on a route the registry does not carry, rather than rendering nothing. */
import { computeOverview } from '../lib/overview';
import { OUTCOME_STATS, PARAM_DEFS, CALENDAR_ANCHOR_NOTE } from '../lib/params';
import { paramBandNote, sliderSpreadNote } from '../lib/scenarios';
import {
  CARE_SCENARIOS, careMoney, moneyRange,
  careChipText, careEarlyText, carePhasingText, careRequirementText,
  RESIDUAL_BILLING_CAVEAT
} from '../lib/care';
import { selfTestSummary } from '../lib/selftests';

const v = computeOverview('SCN-BASE', null);
const gapsList = ' ' + PARAM_DEFS.filter((p) => p.confidence === 'low').map((p) => p.label).join(' · ');
const selftests = selfTestSummary();
/* R81 [§S8]: the card years are read off the ramps that deliver them, at build
   time for the base scenario. R85: health-client.ts re-renders these same four
   sentences from the same functions when a stress scenario shifts the ramps,
   so the page and the client cannot phrase the fact differently. */
const careLines = CARE_SCENARIOS.map((s) => ({
  chip: careChipText(s),
  phasing: carePhasingText(s),
  early: careEarlyText(s),
  requirement: careRequirementText(s)
}));
---
<BaseLayout
  title="National Health Assurance: Healthcare"
  description="What American healthcare costs today, what people would pay under National Health Assurance, and the full system-cost model behind both figures."
>
  <main>

    <section class="card chapter-intro">
      <span class="chapter-intro-eyebrow">{chapterMarker(chapterNumber('health'))} · The need and the promise</span>
      <h2>What people would receive, what care costs, and what the whole system costs</h2>
      <p class="desc">This chapter is the working core of the plan. It starts
        with the household: what real care episodes cost today versus under
        National Health Assurance, the documented effects the cost model
        deliberately does not price, and a live calculator for a household's
        own annual bill. It then opens up to the full system model, computed
        bottom-up from sourced parameters: the total price tag, how the money
        re-routes, who pays, whether the result survives an outside reality
        check, and the methodology and limits behind every number. The next
        chapter turns to how the whole thing is financed.</p>
    </section>

    <section class="card" id="care-card-section">
      <h2>What you'd pay for care</h2>
      <p class="desc">Here is what that design means for real care episodes:
        today's typical cost with employer insurance, without insurance, and
        under NHA. Each card's year is the year the ramp that delivers that
        benefit finishes delivering it, not the year the phase containing it
        opens. Pick a stress scenario further down the page and these years
        move with the ramps it delays, so the cards and the model cannot say
        different things about the same benefit.</p>
      <div class="care-grid" id="care-cards">
        {CARE_SCENARIOS.map((s, i) => (
          <div class="care-card">
            <div class="care-title">{s.title}</div>
            <div class="care-rows">
              <div class="care-row">
                <div class="care-row-label">Today, typical insured</div>
                <div class="care-row-val">{moneyRange(s.todayInsured.lo, s.todayInsured.hi)}</div>
              </div>
              <div class="care-row-note">{s.todayInsured.note}</div>
              <div class="care-row">
                <div class="care-row-label">Today, uninsured</div>
                <div class="care-row-val">{moneyRange(s.todayUninsured.lo, s.todayUninsured.hi)}</div>
              </div>
              <div class="care-row-note">{s.todayUninsured.note}</div>
            </div>
            <div class="care-nha">
              <div class="care-nha-line">
                <div class="care-nha-label">Under NHA</div>
                <div class="care-nha-val" aria-describedby="care-residual-note">{careMoney(s.nha.amount)}</div>
                <div class="care-year-chip" data-care-chip={s.id} title={CALENDAR_ANCHOR_NOTE}>{careLines[i].chip}</div>
              </div>
              <div class="care-nha-phasing" data-care-phasing={s.id} hidden={careLines[i].phasing === null}>{careLines[i].phasing}</div>
              {careLines[i].early !== null && (
                <div class="care-nha-phasing" data-care-early={s.id}>{careLines[i].early}</div>
              )}
              <div class="care-nha-note">{s.nha.note}</div>
              {careLines[i].requirement !== null && (
                <div class="care-nha-req" data-care-req={s.id}>{careLines[i].requirement}</div>
              )}
            </div>
            <div class="care-src">Source: {s.source} <span class={"conf " + s.confidence}>{s.confidence}</span></div>
          </div>
        ))}
      </div>
      <p class="note" id="care-residual-note">{RESIDUAL_BILLING_CAVEAT}</p>
    </section>

    <section class="card">
      <h2>Beyond dollars: what the model does not price</h2>
      <p class="desc">Some effects of universal coverage are well documented
        but deliberately kept out of the cost arithmetic, because turning
        lives and solvency into dollars invites false precision. They belong
        in the picture anyway. Each figure notes the NHA mechanism that
        addresses it.</p>
      <div class="tiles" id="outcome-tiles">
        {OUTCOME_STATS.map((s) => (
          <div class="tile">
            <div class="value">{s.value}</div>
            <div class="label">{s.label}</div>
            <div class="range">{s.note} <span class={"conf " + s.confidence}>{s.confidence}</span></div>
          </div>
        ))}
      </div>
      <p class="note">The utilization-increase parameter in the model is the
        cost side of these same effects: people who stop skipping care start
        using it. The model prices that; it does not claim credit for the
        health improvements that follow.</p>
    </section>

    <section class="card">
      <h2>Your household's annual healthcare bill</h2>
      <p class="desc">Premiums plus out-of-pocket costs today, versus the
        mature system, where the question for a household becomes the tax
        design. The tax line below is computed live from this model's financing
        results and the plan's household-protection cap.</p>
      <div id="household-calc"></div>
    </section>

    <section class="card" id="hero-card">
      <h2>The system-level price tag</h2>
      <p class="desc">This model's own projection, computed bottom-up from
        sourced parameters: what the fully-mature system would cost at today's
        (2024) scale, directly comparable with the ~$5.3T the U.S. actually
        spends now. The savings levers (drug negotiation, administrative
        consolidation, payment reform) largely pay for the benefit expansions
        (universal coverage, $0 care, long-term care, dental/vision/hearing,
        behavioral health).</p>
      <div class="hero-pair-label">If the mature system existed today, at 2024 scale</div>
      <div class="hero">
        <div class="hero-block">
          <div class="label">NHA, fully mature (median)</div>
          <div class="hero-num" id="hero-value">{v.heroValue}</div>
          <div class="range" id="hero-range">{v.heroRange}</div>
        </div>
        <div class="hero-block">
          <div class="label">What the U.S. actually spends, 2024</div>
          <div class="hero-num" style="color:var(--text-secondary)">$5.3T/yr</div>
          <div class="range">CMS preliminary</div>
        </div>
      </div>
      <div class="hero-pair-label">In 2041, at 2041's size (still measured in 2024 dollars)</div>
      <div class="hero">
        <div class="hero-block">
          <div class="label">NHA at steady state (median)</div>
          <div class="hero-num" id="hero-2041-nha">{v.nha2041}</div>
          <div class="range" id="hero-2041-range">{v.hero2041Range}</div>
        </div>
        <div class="hero-block">
          <div class="label">Status quo, same year</div>
          <div class="hero-num" style="color:var(--text-secondary)" id="hero-2041-base">{v.base2041}</div>
          <div class="range">CMS's own trajectory, no reform; the country is bigger and older either way</div>
        </div>
      </div>
      <div class="takeaway" id="family-burden-note">{v.familyNote}</div>
      <div class="tiles" id="tiles">
        {v.tiles.map((it) => (
          <div class="tile">
            <div class="label">{it.label}</div>
            <div class="value">{it.value}</div>
            <div class="range">{it.range}</div>
          </div>
        ))}
      </div>
      <p class="note"><b>Reading the pairs:</b> each row compares like with
        like. The first row asks what the mature system would cost if it
        existed today; the second asks what the annual bill looks like in
        2041, when the country is bigger and older under either system.
        Never compare across rows: the jump from ~$5.3T to ~$9T happens with
        or without reform, and it is more people, older people, and more
        care per person, not inflation. Every dollar on this page is in 2024
        purchasing power.</p>
    </section>

    <section class="card">
      <h2>Assumptions</h2>
      <p class="desc">Pick a stress scenario from the 19-scenario
        catalog, or adjust individual assumptions. Badges show evidence quality:
        <span class="conf high">high</span> = official statistic or scored estimate,
        <span class="conf medium">medium</span> = reputable study or survey,
        <span class="conf low">low</span> = analyst assumption with no direct source.</p>
      <div class="controls" id="controls"></div>
      <p class="scenario-desc" id="scenario-desc"></p>
      <div id="scenario-basis"></div>
      <p class="note">{sliderSpreadNote()}</p>
      <div class="controls-foot">
        <button class="btn" id="reset-btn">Reset assumptions</button>
        <span class="runs-note" id="runs-note"></span>
      </div>
    </section>

    <section class="card">
      <h2>Annual total system cost, 2027–2042</h2>
      <p class="desc">The status-quo path follows CMS's own spending trajectory.
        The NHA path phases in over the Phase 0–8 roadmap
        (coverage waves from Year 4, national default coverage Year 8, expanded
        long-term-care/behavioral/dental benefits Years 10–12), including all
        transition costs. The band is the 10th–90th percentile across Monte
        Carlo draws of every uncertain parameter.</p>
      <div id="path-chart"></div>
      <p class="note" id="growth-decomp"></p>
      <details class="tableview"><summary>View as table</summary>
        <div class="tbl-scroll"><table class="data" id="path-table"></table></div>
      </details>
    </section>

    <section class="card">
      <h2>How the money re-routes</h2>
      <p class="desc">The most misunderstood part of a public
        system: society's total spending barely changes; <em>the routes
        change</em>. Compare the flow you saw at the top of the page with the
        same flow under NHA. Premiums and point-of-care bills disappear; the
        same dollars reach the same doctors and hospitals through public
        financing instead. Hover any ribbon for what it contains.</p>
      <div class="flow-grid">
        <div class="flow-panel">
          <div class="flow-title">Today: actual 2023 spending ($4.87T, CMS)</div>
          <div id="flow-today"></div>
        </div>
        <div class="flow-panel">
          <div class="flow-title" id="flow-nha-title">Under NHA: mature system at 2024 scale</div>
          <div id="flow-nha"></div>
        </div>
      </div>
      <div class="takeaway" id="flow-takeaway"></div>
    </section>

    <section class="card">
      <h2>Who pays</h2>
      <p class="desc">Mature-year public cost funded by redirecting what
        government already spends, a state maintenance-of-effort contribution,
        an employer contribution replacing today's premiums, and the remainder,
        which requires new revenue. The comparison shows how far the
        extreme-wealth tax package goes toward that gap.</p>
      <div id="financing-chart"></div>
      <p class="note" id="financing-note"></p>
      <details class="tableview"><summary>View as table</summary>
        <div class="tbl-scroll"><table class="data" id="financing-table"></table></div>
      </details>
    </section>

    <section class="card">
      <h2>Why the total lands where it does</h2>
      <p class="desc">The bridge from the status-quo baseline at maturity (2041)
        to the NHA total, using central-estimate parameters. Each saving
        mechanism appears exactly once: the model computes both worlds directly
        and derives these differences, so nothing can be double-counted.</p>
      <div id="bridge-chart"></div>
      <p class="note" id="bridge-note"></p>
      <details class="tableview"><summary>View as table</summary>
        <div class="tbl-scroll"><table class="data" id="bridge-table"></table></div>
      </details>
    </section>

    <section class="card benchmark-section">
      <h2>Does the model pass an outside reality check?</h2>
      <p class="desc">Internal tests can show that the arithmetic works. They
        cannot show whether the result is plausible. These checks compare the
        model with observed U.S. spending and independent estimates of
        single-payer systems. Similar scale supports plausibility; it does not
        prove that any one outcome will occur.</p>

      <div class="benchmark-purpose-grid">
        <article>
          <span>Check 1</span>
          <strong>The nation&apos;s total healthcare bill</strong>
          <p>What would households, employers, states, and the federal
            government spend in total? This tests the overall size of the
            model.</p>
        </article>
        <article>
          <span>Check 2</span>
          <strong>The shift onto the federal budget</strong>
          <p>How much additional spending would appear on the federal ledger?
            This tests the scale of the financing transfer.</p>
        </article>
      </div>

      <div class="benchmark-distinction">
        <strong>Keep the two checks separate.</strong>
        Added federal spending is not the same as added national healthcare
        spending. Much of the federal increase replaces premiums,
        point-of-care bills, employer spending, and state spending that already
        exist elsewhere in the system.
      </div>

      <article class="benchmark-panel">
        <div class="benchmark-panel-head">
          <span>Check 1</span>
          <div>
            <h3>Is the total system price tag in a credible range?</h3>
            <p>The dashboard&apos;s mature system at today&apos;s population and
              economy is compared with what the United States actually spent
              in 2024. Both figures include all payers.</p>
          </div>
        </div>
        <div class="benchmark-key" aria-label="Chart key">
          <span><i class="benchmark-key-model"></i>Dashboard model range and median</span>
          <span><i class="benchmark-key-outside"></i>Observed or outside estimate</span>
        </div>
        <div id="benchmark-nhe"></div>
        <p class="benchmark-readout">
          <strong>Readout:</strong>
          <span id="benchmark-nhe-result"></span>
        </p>
        <p class="benchmark-readout">
          <strong>The plan&apos;s own stated figure:</strong>
          <span id="benchmark-claim-result"></span>
        </p>
      </article>

      <article class="benchmark-panel">
        <div class="benchmark-panel-head">
          <span>Check 2</span>
          <div>
            <h3>How does the federal financing shift compare?</h3>
            <p>The dashboard&apos;s added federal spending is compared with CBO,
              Urban Institute, and Mercatus estimates. This is a budget
              comparison, not a measure of new cost to society or the exact
              amount of new tax revenue required. The sources use different
              years, benefit designs, and transition speeds, so this check is
              intentionally approximate.</p>
          </div>
        </div>
        <div class="benchmark-figure-grid">
          <article>
            <span>Dashboard model</span>
            <strong id="benchmark-fed-model">...</strong>
            <small id="benchmark-fed-model-range"></small>
            <p>Mature system, 2041-scale economy, real 2024 dollars</p>
          </article>
          <article>
            <span>CBO <i class="conf high">high</i></span>
            <strong>$1.5T–$3.0T/yr</strong>
            <small>Federal subsidy increase</small>
            <p>Illustrative single-payer options in 2030, study dollars</p>
          </article>
          <article>
            <span>Urban Institute / Mercatus <i class="conf medium">medium</i></span>
            <strong>$3.2T–$3.4T/yr</strong>
            <small>Annualized federal increase</small>
            <p>First-decade estimates, each study&apos;s own dollars</p>
          </article>
        </div>
        <p class="benchmark-readout">
          <strong>Readout:</strong>
          <span id="benchmark-fed-result"></span>
        </p>
      </article>

      <div class="benchmark-supporting">
        <span>Supporting check</span>
        <h3>Does the 2030 change in total spending have a plausible scale?</h3>
        <p id="benchmark-2030-result"></p>
      </div>

      <div class="benchmark-verdict">
        <span>Overall interpretation</span>
        <p id="benchmark-verdict"></p>
      </div>
      <p class="benchmark-source">
        <a href="https://github.com/mikehalvorson/US-National-Health-Assurance-System/blob/main/research/01_macro_financing_population_offsets.md"
          target="_blank" rel="noopener">Sources and methodology</a>.
        Published estimates retain each study&apos;s accounting basis and
        publication-year dollars.
      </p>
    </section>

    <section class="card">
      <h2>Methodology and limits</h2>
      <div class="note">
        <b>What this is:</b> a national-aggregate annual model. It computes
        the status-quo world and the NHA world category by category from CMS
        2023 calibration data, phases policy in over the Phase 0–8
        roadmap, and samples every uncertain parameter from a sourced
        low/central/high range (triangular distribution). Draws share a
        systemic optimism/pessimism factor (weight 0.35): runs where benefit
        expansions overrun also tend to be runs where savings levers
        underdeliver, which widens the tails compared with independent
        sampling. Employer premium savings pass through to wages (adjustable,
        40–95%, CBO convention) and the resulting income/payroll tax revenue
        feeds back into financing. Steady state is the 2040–2042 average.
      </div>
      <div class="note">
        <b>On the original headline figure:</b> the plan states a mature total
        system cost without deriving one. What that figure counts is settled by
        the plan's own cost catalog rather than by this dashboard, and the
        comparison against it is computed and shown with the other credibility
        checks above, on that same accounting basis. It is a comparison line,
        never a target: no parameter here is tuned to reproduce it.
      </div>
      <div class="note">
        <b>What it still is not:</b> specialty-level queues and wait-time
        dynamics are not modeled, nor is provider behavioral response beyond
        the payment factor. Macroeconomic feedback stops at first-order wage
        pass-through with a fixed 28% marginal-rate revenue feedback; there
        are no general-equilibrium or labor-supply effects. The correlation
        structure is a single systemic factor, not a full covariance matrix.
        Geographic detail exists for the care network (see the Physical Care
        tab) but the fiscal model's costs and prices remain national
        averages. Health outcomes are displayed with sources in the section
        above, not converted into dollars. Demographic aging is decomposed
        and shown under the cost-path chart, but the model does not simulate
        cohorts individually.
      </div>
      <div class="warnbox" id="gaps-box">
        <b>Weakest assumptions.</b> These parameters have no direct real-world
        source and materially move the result. They are flagged
        <span class="conf low">low</span> in the controls and listed with their
        derivation anchors in the full parameter table below.
        <span id="gaps-list">{gapsList}</span>
      </div>
      <details class="tableview"><summary>Full parameter table with sources (the entire evidence base)</summary>
        <p class="note"><b>What the low and high columns mean.</b> {paramBandNote()}</p>
        <div class="tbl-scroll">
          <table class="data" id="param-table">
            <thead><tr>
              <th>Parameter</th><th class="num">Low</th><th class="num">Central</th>
              <th class="num">High</th><th>Unit</th><th>Confidence</th><th>Source</th>
            </tr></thead>
            <tbody>
              {PARAM_DEFS.map((p) => (
                <tr>
                  <td>{p.label}</td>
                  <td class="num">{(+p.low.toFixed(2)).toLocaleString('en-US')}</td>
                  <td class="num">{(+p.mode.toFixed(2)).toLocaleString('en-US')}</td>
                  <td class="num">{(+p.high.toFixed(2)).toLocaleString('en-US')}</td>
                  <td>{p.unit}</td>
                  <td><span class={"conf " + p.confidence}>{p.confidence}</span></td>
                  <td>{p.source} {p.url && (<a href={p.url} target="_blank" rel="noopener">[link]</a>)}
                    {p.divergence && (
                      <div class="divergence">
                        <b>Diverges from the research recommendation ({p.divergence.leans}).</b>
                        {' '}Recommended: {p.divergence.recommended}. {p.divergence.note}
                      </div>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      <div class="selftest" id="selftest">
        <div>Model integrity: <span class={selftests.passed === selftests.total ? 'pass' : 'fail'}>{
          selftests.passed === selftests.total
            ? 'All ' + selftests.total + ' model self-tests pass.'
            : (selftests.total - selftests.passed) + ' of ' + selftests.total + ' self-tests FAILING.'
        }</span></div>
        <ul>
          {selftests.rows.map((r) => (
            <li>{r.ok ? '✓ ' + r.name : '✗ ' + r.name + ': ' + r.note}</li>
          ))}
        </ul>
      </div>
    </section>

    <ChapterNav />
  </main>
</BaseLayout>

<script>
  import '../scripts/health-client.ts';
</script>
