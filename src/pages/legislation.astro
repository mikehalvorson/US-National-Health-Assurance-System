---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterNav from '../components/ChapterNav.astro';
import {
  DOMAINS, ENABLING_ACT_TITLE_COUNT, numberedActGroups
} from '../lib/legislation';

/* R297 [§S12]: the title numbering is derived. The five groups used to render
   <ol start="1">, start="5", start="11", start="13" and start="17" with the
   Roman numeral typed into every <li>; each was correct, and inserting one
   title into any group would have misnumbered every group after it twice per
   item with nothing to notice.

   R240 [§S12]: the three hero tiles below typed 19, 13 and 7 beside each
   other. The row is the pattern R240 names - a tile deriving one number and
   typing the next - so all three read their collection.

   R292 [§S12]: the two aria-labels on this page spelled counts as words
   ("Nineteen-title", "Seven-step") where nothing could contradict them, on
   containers with no role. Those numbers are derived now too. */
const actGroups = numberedActGroups();
const titleCount = ENABLING_ACT_TITLE_COUNT;
const domainCount = DOMAINS.length;
const STEPS = [
  ['Close the legal crosswalk', 'Legislative counsel maps every affected federal section and each state, territorial, and tribal interface to a named disposition.'],
  ['Enact the ' + titleCount + '-title act', 'Rights, institutions, mandatory funding, revenue, remedies, formulas, defaults, and transition authority take effect on sequenced dates.'],
  ['Amend legacy code', 'Congress inserts conforming text, savings clauses, severability, transition rules, and revival fallbacks before any repeal can operate.'],
  ['Fund and appoint', 'Trust funds, direct spending, appropriations, offices, inspectors, scorekeepers, courts, succession, and staffing floors become operational.'],
  ['Rule and compact', 'Agencies use APA notice and comment; governments execute clear, funded, voluntary compacts with data, audit, cure, and exit terms.'],
  ['Run systems in parallel', 'Claims, records, pharmacy, hospitals, and eligibility migrate in certified waves while predecessor benefits and pending cases remain protected.'],
  ['Sunset only after Gate 8', 'Legacy authority closes only after record, financial, workforce, appeal, continuity, and fallback evidence is independently certified.'],
];
---
<BaseLayout
  title="National Health Assurance: Legislation"
  description="The nineteen-title enabling act, the federal laws it amends, and the sequence from constitutional authority to mature operation."
>
  <main>

  <section class="card legislation-hero">
    <span class="legislation-kicker">The legal operating plan</span>
    <h2>Build the successor system in law before retiring the systems it replaces</h2>
    <p class="desc">The plan is built on one National Health Assurance and
      Health System Transition Act, organized into {titleCount} titles, followed by
      controlled federal conforming amendments and state, regional, and tribal
      implementation instruments. Every legacy legal function receives one
      explicit disposition: preserve, parallel, transfer, amend, preempt,
      sunset, or fall back.</p>
    <div class="legislation-counts" aria-label="Legislative architecture summary">
      <article><strong>{titleCount}</strong><span>titles in the enabling act</span></article>
      <article><strong>{domainCount}</strong><span>major legal domains to reconcile</span></article>
      <article><strong>{STEPS.length}</strong><span>controlled enactment and activation steps</span></article>
    </div>
    <div class="legislation-path" aria-label="Path from constitutional authority to mature operation">
      <article><span>Authority</span><strong>Article I powers</strong><small>tax, spend, regulate, implement</small></article>
      <i aria-hidden="true">&rarr;</i>
      <article><span>New law</span><strong>{titleCount}-title enabling act</strong><small>rights, money, institutions, remedies</small></article>
      <i aria-hidden="true">&rarr;</i>
      <article><span>Reconcile</span><strong>Conforming amendments</strong><small>federal code, savings clauses, fallbacks</small></article>
      <i aria-hidden="true">&rarr;</i>
      <article><span>Federalism</span><strong>Compacts and floors</strong><small>states, regions, tribes, direct federal option</small></article>
      <i aria-hidden="true">&rarr;</i>
      <article><span>Execute</span><strong>Rules and appropriations</strong><small>APA process, mandatory funding, oversight</small></article>
      <i aria-hidden="true">&rarr;</i>
      <article><span>Activate</span><strong>Gated rollout</strong><small>successor first; legacy sunset last</small></article>
    </div>
    <div class="legislation-constitutional-answer">
      <strong>Constitutional amendment: not required for implementation.</strong>
      <span>Congress can construct the statutory system around its taxing,
        spending, commerce, Indian-affairs, and necessary-and-proper powers.
        An amendment is optional if the goal is to place an affirmative
        healthcare right above ordinary legislation.</span>
    </div>
  </section>

  <section class="card">
    <span class="legislation-kicker">The principal statute</span>
    <h2>What Congress must enact</h2>
    <p class="desc">The titles below are the legal containers; legislative counsel would
      convert each requirement, parameter, appeal, funding formula, and
      continuity trigger into operative sections.</p>
    <div class="legislation-title-stack" role="list"
      aria-label={titleCount + "-title enabling act architecture"}>
      {actGroups.map((g) => (
        <article role="listitem">
          <span>{g.heading}</span>
          <ol start={g.start}>
            {g.titles.map((t) => <li><b>{t.roman}</b> {t.title}</li>)}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="card">
    <span class="legislation-kicker">Interactive legal crosswalk</span>
    <h2>Which existing laws change, and what happens to them</h2>
    <p class="desc">This is the complete major-law-family map identified by
      the plan, not a claim that a provision-by-provision national legal
      audit is already finished. Select a domain to see the statutes, the
      required disposition, the implementation method, the retained
      protections, and the rollout point.</p>
    <div class="legislation-crosswalk">
      <div id="legislation-law-list" class="legislation-law-list"
        aria-label="Select a legal domain"></div>
      <article id="legislation-law-detail" class="legislation-law-detail"
        aria-live="polite"></article>
    </div>
    <div class="legislation-disposition-key" aria-label="Legal disposition key">
      <span><b>Preserve</b> stays operative</span>
      <span><b>Parallel</b> runs beside the successor</span>
      <span><b>Transfer</b> moves a function</span>
      <span><b>Amend</b> changes existing text</span>
      <span><b>Preempt</b> displaces only a conflict</span>
      <span><b>Sunset</b> closes after certification</span>
      <span><b>Fallback</b> revives a safe default</span>
    </div>
  </section>

  <section class="card">
    <span class="legislation-kicker">Federalism by design</span>
    <h2>Federal, state, and tribal authority must be separated precisely</h2>
    <p class="desc">The federal statute should operate directly where national
      uniformity is indispensable, preserve traditional state health and
      safety functions, and recognize tribal sovereignty and federal trust
      duties. It cannot force state officers to administer a federal program.</p>
    <div class="legislation-federalism">
      <article>
        <span>Federal direct authority</span>
        <h3>One national floor and a direct operating fallback</h3>
        <ul>
          <li>Coverage, benefits, payment rights, financing, national data and claims standards</li>
          <li>Federal institutions, appropriations, remedies, audit, and continuity duties</li>
          <li>Narrow express preemption when a state rule materially blocks the federal guarantee</li>
        </ul>
      </article>
      <article>
        <span>State authority preserved</span>
        <h3>Health, safety, licensure, and more-protective rules</h3>
        <ul>
          <li>Professional licensure, discipline, facility safety, public health, and corporate law</li>
          <li>Supplemental benefits and protections that exceed the federal floor</li>
          <li>Voluntary administration through funded compacts with clear conditions and exit rules</li>
        </ul>
      </article>
      <article>
        <span>Tribal sovereignty and trust</span>
        <h3>Direct nation-to-nation implementation</h3>
        <ul>
          <li>No diminution of treaty, trust, IHS, or self-determination rights</li>
          <li>Direct federal-tribal funding and compacts without a required state intermediary</li>
          <li>Tribal control of service design, data governance, workforce, and local integration</li>
        </ul>
      </article>
    </div>
    <div class="legislation-preemption-band">
      <strong>Preemption rule:</strong>
      <span>displace only the state rule that creates the actual conflict;
        retain savings clauses for health, safety, privacy, remedies, tribal
        authority, and stronger patient protection.</span>
    </div>
  </section>

  <section class="card">
    <span class="legislation-kicker">From bill text to live authority</span>
    <h2>How implementation would be performed</h2>
    <p class="desc">The legal transition follows the same safety logic as the
      clinical rollout: create the successor authority, prove it can operate,
      migrate by certified wave, and retire the predecessor only after
      continuity evidence passes.</p>
    <div class="legislation-steps" role="list"
      aria-label={STEPS.length + "-step legislative implementation sequence"}>
      {STEPS.map(([title, detail], i) => (
        <article role="listitem">
          <span>{String(i + 1).padStart(2, '0')}</span><strong>{title}</strong><p>{detail}</p>
        </article>
      ))}
    </div>
    <div class="legislation-passage-note">
      <article><b>Regular legislation</b><span>can carry the full institutional,
        rights, regulatory, and remedial design.</span></article>
      <article><b>Budget reconciliation</b><span>can carry qualifying spending
        and revenue provisions, but Senate rules expose nonbudgetary provisions
        to a Byrd Rule point of order.</span></article>
      <article><b>House origination</b><span>should be used for the revenue title
        to avoid an Origination Clause challenge.</span></article>
    </div>
  </section>

  <section class="card">
    <span class="legislation-kicker">Constitutional architecture</span>
    <h2>What the Constitution permits, constrains, and could optionally guarantee</h2>
    <div class="legislation-constitutional-grid">
      <article><span>Article I</span><h3>Enumerated federal powers</h3><p>Anchor financing in the taxing and spending powers; regulate interstate healthcare markets; use necessary-and-proper means tied to those powers.</p></article>
      <article><span>Tenth Amendment</span><h3>No commandeering or coercion</h3><p>Administer federal duties federally. State participation must use clear, prospective, noncoercive funding terms and a workable direct federal option.</p></article>
      <article><span>Article II</span><h3>Executive power remains presidential</h3><p>After <i>Trump v. Slaughter</i>, officers within the President's general administrative control must be removable at will.</p></article>
      <article><span>Fifth Amendment</span><h3>Process, property, and equal treatment</h3><p>Give notice, hearings, review, compensation where property is taken, and rational, nondiscriminatory transition rules for patients and institutions.</p></article>
      <article><span>First Amendment and RFRA</span><h3>Belief does not erase patient access</h3><p>Draft conscience rules narrowly, protect individual rights, and ensure an effective alternative provider and emergency-care pathway.</p></article>
      <article><span>Supremacy Clause</span><h3>Express, bounded preemption</h3><p>State law yields only where Congress validly says so or a true conflict exists; explicit savings clauses prevent accidental field preemption.</p></article>
    </div>
    <div class="legislation-amendment-layout">
      <div>
        <span class="legislation-kicker">Optional, not required</span>
        <h3>Illustrative Twenty-Eighth Amendment</h3>
        <p>This language would constitutionalize an affirmative floor while
          leaving Congress responsible for benefit definition, financing, and
          implementation. It is a drafting concept for legislative counsel,
          not final bill text.</p>
        <div class="legislation-ratification">
          <strong>2/3</strong><span>of both houses to propose</span>
          <i aria-hidden="true">&rarr;</i>
          <strong>3/4</strong><span>of states to ratify</span>
        </div>
      </div>
      <blockquote class="legislation-amendment-text">
        <p><b>Section 1.</b> Every person within the jurisdiction of the
          United States has the right, as provided by law, to timely access
          to medically necessary health care without discrimination and
          without financial barriers at the point of service.</p>
        <p><b>Section 2.</b> Congress shall have power to enforce and
          implement this article by appropriate legislation, including by
          establishing national standards, financing, remedies, and
          reasonable implementation schedules. A State may provide greater
          protection.</p>
        <p><b>Section 3.</b> No benefit, payment, or appeal right secured by
          law under this article may be suspended or terminated by executive
          action contrary to law.</p>
      </blockquote>
    </div>
  </section>

  <section class="card">
    <span class="legislation-kicker">What must be finished before introduction</span>
    <h2>The structure is specified; legal validation remains an open workstream</h2>
    <p class="desc">Six legal work products remain unfinished. A
      responsible bill cannot call the crosswalk complete until they are
      public, versioned, and reviewed.</p>
    <div class="legislation-open-grid">
      <article><span>01</span><strong>Federal section-by-section table</strong><p>Current citation, affected function, disposition, replacement section, effective date, savings clause, and fallback.</p></article>
      <article><span>02</span><strong>Fifty-state and territorial annex</strong><p>Insurance, licensure, scope, facility, public-health, tax, labor, debt, privacy, and corporate-law interfaces.</p></article>
      <article><span>03</span><strong>Tribal consultation record</strong><p>Treaty, trust, self-determination, service, funding, data-sovereignty, and compact terms developed nation to nation.</p></article>
      <article><span>04</span><strong>Constitutional and litigation red team</strong><p>Enumerated power, federalism, removal, appointments, due process, takings, speech, religion, standing, remedies, and severability.</p></article>
      <article><span>05</span><strong>Budget and tax scores</strong><p>CBO and JCT scoring, trust-fund flows, appropriation classification, reconciliation limits, and state fiscal transition.</p></article>
      <article><span>06</span><strong>Operational readiness schedule</strong><p>Rulemaking, appointments, procurement, systems, compacts, workforce, claims, records, and Gate 8 sunset evidence.</p></article>
    </div>
    <div class="legislation-current-law-note">
      <strong>Current-law alert · June 29, 2026</strong>
      <span>The Supreme Court held in <i>Trump v. Slaughter</i> that the
        FTC's for-cause removal protection was unconstitutional. Executive
        hardening therefore must rely on statutory duties, mandatory funding,
        evidence outside operations, courts, inspectors, congressional
        offices, defaults, and remedies, not an assumption that executive
        regulators can be made independent of presidential removal.</span>
    </div>
    <p class="rollout-source">
      <a href="https://github.com/mikehalvorson/US-National-Health-Assurance-System/blob/main/research/legislation_crosswalk.md"
        target="_blank" rel="noopener">Sources and legal crosswalk methodology</a>.
      <a href="https://constitution.congress.gov/browse/article-5/"
        target="_blank" rel="noopener">Article V process</a>.
      <a href="https://www.supremecourt.gov/opinions/25pdf/25-332_qn12.pdf"
        target="_blank" rel="noopener">Trump v. Slaughter</a>.
      This page is a legislative planning map, not legal advice.</p>
  </section>

    <ChapterNav />
  </main>
</BaseLayout>

<script>
  import '../scripts/legislation-client.ts';
</script>
