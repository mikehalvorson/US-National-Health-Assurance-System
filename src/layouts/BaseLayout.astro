---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import TabNav from '../components/TabNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description?: string }
const { title, description } = Astro.props;
const pathname = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <ClientRouter />
  <script>import '../scripts/acronyms-client.ts';</script>
</head>
<body>
  {/* R268 [S14]: the first focusable element on every page. Without it the
       header's sources link and TabNav's fourteen chapter links stand between
       a keyboard user and the content, and <ClientRouter /> returns focus to
       the top of the document on every in-app navigation, so the cost is paid
       again on every chapter change. It sits outside .wrap so that nothing a
       page or component adds can precede it in tab order. */}
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="wrap">
    <SiteHeader />
    <TabNav pathname={pathname} />
    {/* The skip link's target lives beside the link. Review 9 of P20: it
        was hand-copied into all fourteen pages, so a fifteenth page could
        ship a skip link that goes nowhere. tabindex="-1" because a bare
        <main> is not focusable, and href="#main" would move the reading
        position while leaving the tab order where it was. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </div>
</body>
</html>
